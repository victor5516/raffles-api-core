# Upstreams (Nombres de los servicios en Docker)
upstream backend_client_1 {
    server api_simon:3000;
}

client_max_body_size 20M;

# --- BLOQUE HTTP (Redirección a HTTPS para TODOS) ---
server {
    listen 80;
    server_name ${DOMAIN_CLIENT_1};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# --- BLOQUE HTTPS: CLIENTE 1 (Simon) ---
server {
    listen 443 ssl;
    server_name ${DOMAIN_CLIENT_1};

    # Aumentar límite de tamaño de archivos para este servidor
    client_max_body_size 20M;

    # Certificados SSL Dinámicos
    ssl_certificate /etc/letsencrypt/live/${DOMAIN_CLIENT_1}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN_CLIENT_1}/privkey.pem;

    # TLS inline (no depende de options-ssl-nginx.conf descargado por certbot en el host)
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;

    location / {
        proxy_pass http://backend_client_1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}